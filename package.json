{
  "name": "casino-reel-builder",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["ffmpeg-static"]
  },
  "scripts": {
    "reel": "node --import tsx src/cli/index.ts",
    "studio": "remotion studio src/render/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "assets:generate": "node --import tsx scripts/generate-original-assets.ts"
  },
  "dependencies": {
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/bundler": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "commander": "15.0.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "pixi.js": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
